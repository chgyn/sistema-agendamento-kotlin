# ==============================================================================
# Variáveis de Ambiente do Sistema Monolítico BarberFlow
# Copie este arquivo para .env caso deseje customizar valores padrão
# ==============================================================================

# Porta da Aplicação Monolítica (Ktor + Vue 3)
PORT=8080

# Banco de Dados PostgreSQL 16
POSTGRES_USER=barber_user
POSTGRES_PASSWORD=barber_pass123
POSTGRES_DB=barbershop_db
DATABASE_URL=jdbc:postgresql://postgres:5432/barbershop_db
DATABASE_USER=barber_user
DATABASE_PASSWORD=barber_pass123

# Cache & Filas Redis 7
REDIS_HOST=redis
REDIS_PORT=6379

# Segurança & Autenticação JWT
JWT_SECRET=barbershop-ultra-secure-jwt-secret-key-2026-production
JWT_ISSUER=https://barbershop.local
JWT_AUDIENCE=barbershop-users
JWT_REALM=BarbershopRealm
